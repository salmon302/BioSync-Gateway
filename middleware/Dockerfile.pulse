# Multi-stage build for BioSync-Gateway middleware with the REAL
# Kitware Pulse Physiology Engine ("Pulse" Python bindings, a.k.a. PyPulse).
#
# Implements SRS FR-3.6.1-3.6.5 / FR-3.11-3.14 and closes REMAINING_WORK R1
# (physiological fidelity). The native engine is COMPILED FROM SOURCE in stage
# 1 (validated stable tag) and copied into a slim Python 3.11 runtime in stage
# 2. The builder and runtime use the SAME Python (3.11) so the compiled
# extension module is ABI-compatible.
#
# Build / run:
#   docker build -f middleware/Dockerfile.pulse -t biosync-pulse middleware
#   MIDDLEWARE_DOCKERFILE=Dockerfile.pulse docker compose up --build
#
# Acceptance (R1): `import Pulse` succeeds in the runtime image and
# IQ-4 / OQ-16 / PQ-2 / PQ-6 pass against the real engine.

# =============================================================================
# Stage 1 - compile Kitware Pulse Physiology Engine from source
# =============================================================================
FROM python:3.11-bullseye AS pulse-builder

ARG PULSE_VERSION=REL_4_3_2
ENV DEBIAN_FRONTEND=noninteractive

# Build toolchain. The Pulse superbuild downloads/compiles its own
# Boost / Protobuf / Eigen / abseil, so we only need the toolchain + SSL/curl.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git wget build-essential cmake \
        unzip pkg-config ca-certificates \
        libssl-dev zlib1g-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone the tagged, validated stable release (ABI matched to python:3.11).
WORKDIR /source
RUN git clone --depth 1 --branch ${PULSE_VERSION} \
        https://gitlab.kitware.com/physiology/engine.git .

# Configure + build. Java/C# APIs are disabled to cut build time + JDK deps.
# Output is installed to /pulse (bin -> shared libs, python -> bindings).
RUN mkdir -p /build /pulse \
    && cd /build \
    && cmake -DPulse_PYTHON_API=ON \
             -DPulse_JAVA_API=OFF \
             -DPulse_CSHARP_API=OFF \
             -DCMAKE_INSTALL_PREFIX=/pulse \
             -DCMAKE_BUILD_TYPE=Release \
             -DPYTHON_EXECUTABLE=/usr/local/bin/python3.11 \
             /source \
    && make -j"$(nproc)" \
    && ( test -e /pulse/python/Pulse/__init__.py || make install ) \
    && cd / && rm -rf /build

# =============================================================================
# Stage 2 - slim runtime with compiled engine + application
# =============================================================================
FROM python:3.11-slim

WORKDIR /app

# Runtime C/C++ libs the compiled engine links against (libstdc++ from gcc).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Copy the compiled engine (module + shared libs) from the builder.
COPY --from=pulse-builder /pulse /pulse
# Safety net: any superbuild-built shared libs (protobuf/boost/abseil).
COPY --from=pulse-builder /usr/local/lib /usr/local/lib
RUN ldconfig

# Expose the compiled bindings to the interpreter.
ENV PYTHONPATH=/pulse/python
ENV LD_LIBRARY_PATH=/pulse/bin:/usr/local/lib:${LD_LIBRARY_PATH}
# Use the real engine when present (real_pulse_available() degrades gracefully
# to the seed-synthesis fallback if the import fails).
ENV BIOSSYNC_REAL_PULSE=1

# Application dependencies (pandas is required by Pulse's pull_data()).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code.
COPY . .

# IQ-4 build gate: the real engine MUST import in the runtime image.
RUN python -c "import Pulse; from Pulse import Engine; print('PyPulse (Pulse) OK:', Pulse.__file__)"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
