# Database Configuration
DB_PASSWORD=biosync_secure_password
POSTGRES_USER=biosync_user
POSTGRES_DB=biosync

# JWT Configuration (SRS NFR-S7: never hard-code secrets)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, inject via Docker secrets (JWT_SECRET_FILE) or env var.
# When ENVIRONMENT=production and JWT_SECRET is unset, the app refuses to start.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# External API Keys (Optional)
# ACCESSGUDID_API_KEY: reserved (AccessGUDID public API needs none today)
# CLINVAR_API_KEY:     NCBI E-utilities key (raises rate limit 3/s -> 10/s)
# OPENFDA_API_KEY:     openFDA key (raises UDI search quota; optional)
ACCESSGUDID_API_KEY=
CLINVAR_API_KEY=
OPENFDA_API_KEY=

# External API response cache directory
# Defaults to <tempdir>/biosync_cache when unset.
BIOSYNC_CACHE_DIR=

# ---------------------------------------------------------------------------
# LLM / RAG Gateway (SRS FR-3.15) — provider abstraction (C8)
# ---------------------------------------------------------------------------
# LLM_PROVIDER selects the OpenAI-compatible backend at runtime, no code change:
#   mock      -> offline deterministic stub (DEFAULT; no network, no key)
#   openrouter-> remote OpenRouter API (requires OPENROUTER_API_KEY)
#   ollama    -> local Ollama OpenAI-compatible shim at OLLAMA_BASE_URL
#   vllm      -> local/remote vLLM OpenAI-compatible server at LLM_VLLM_BASE_URL
LLM_PROVIDER=mock

# OpenRouter (https://openrouter.ai) — set LLM_PROVIDER=openrouter to use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (local) — set LLM_PROVIDER=ollama to use.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# vLLM (local/remote) — set LLM_PROVIDER=vllm to use.
LLM_VLLM_BASE_URL=
LLM_VLLM_MODEL=meta-llama/Llama-3-8b-instruct

# ---------------------------------------------------------------------------
# LLM key injection (SRS NFR-S7) — secrets never hard-coded
# ---------------------------------------------------------------------------
# OpenRouter requires a key. Inject it one of two ways (precedence as listed):
#   1) Direct env (local dev):
#        OPENROUTER_API_KEY=sk-or-...
#   2) Docker secret file (PRODUCTION — preferred). Mount the secret and set:
#        OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_key
#      The gateway reads the file at call time (fail-closed if both missing).
# Ollama and vLLM run on your own infrastructure and need NO API key, so no
# secret injection is required for them.
OPENROUTER_API_KEY_FILE=

# ---------------------------------------------------------------------------
# Ollama integration test opt-in (tests/test_oq_llm_ollama_integration.py)
# ---------------------------------------------------------------------------
# The Ollama integration test is SKIPPED unless BIOSYNC_OLLAMA_INTEGRATION=1,
# and only runs when a local Ollama is reachable. Defaults match a stock
# `ollama serve` (http://localhost:11434, model `llama3`).
BIOSYNC_OLLAMA_INTEGRATION=
BIOSYNC_OLLAMA_BASE_URL=http://localhost:11434
BIOSYNC_OLLAMA_MODEL=llama3

# Static RAG template directory (FR-3.15.3 / C9). Defaults to the bundled
# middleware/ai/rag_templates when unset.
RAG_TEMPLATE_DIR=

# Downstream EHR/FHIR ingestion endpoint for the harness (FR-3.15.7).
# When unset, the harness runs a local round-trip signal-preservation check.
EHR_INGEST_URL=

# ---------------------------------------------------------------------------
# Database TLS (SRS NFR-S4 / NFR-S5) -- mutual-TLS to PostgreSQL
# ---------------------------------------------------------------------------
# The shipped middleware enforces DB_SSLMODE=verify-full automatically when
# ENVIRONMENT=production (R2 remediation). For docker-compose, generate the
# CA + client + server certificates first:
#     ./nginx/generate-certs.sh
# which writes nginx/ssl/* (nginx TLS) and certs/* (Postgres mutual-TLS).
# docker-compose mounts certs/ into both the db (server cert + CA) and the
# middleware (client cert + CA) containers; see docs/db-client-cert-tls.md.
#
# For LOCAL DEV / CI without a PKI, set DB_SSLMODE=prefer (or disable). The
# default in code is verify-full for production, prefer otherwise.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/ca.crt
DB_SSLCERT=/etc/ssl/certs/client.crt
DB_SSLKEY=/etc/ssl/certs/client.key

