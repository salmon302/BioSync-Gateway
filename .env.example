# Database Configuration
DB_PASSWORD=biosync_secure_password
POSTGRES_USER=biosync_user
POSTGRES_DB=biosync

# JWT Configuration (SRS NFR-S7: never hard-code secrets)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, inject via Docker secrets (JWT_SECRET_FILE) or env var.
# When ENVIRONMENT=production and JWT_SECRET is unset, the app refuses to start.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# External API Keys (Optional)
# ACCESSGUDID_API_KEY: reserved (AccessGUDID public API needs none today)
# CLINVAR_API_KEY:     NCBI E-utilities key (raises rate limit 3/s -> 10/s)
# OPENFDA_API_KEY:     openFDA key (raises UDI search quota; optional)
ACCESSGUDID_API_KEY=
CLINVAR_API_KEY=
OPENFDA_API_KEY=

# External API response cache directory
# Defaults to <tempdir>/biosync_cache when unset.
BIOSYNC_CACHE_DIR=

# ---------------------------------------------------------------------------
# LLM / RAG Gateway (SRS FR-3.15) — provider abstraction (C8)
# ---------------------------------------------------------------------------
# LLM_PROVIDER selects the OpenAI-compatible backend at runtime, no code change:
#   mock      -> offline deterministic stub (DEFAULT; no network, no key)
#   openrouter-> remote OpenRouter API (requires OPENROUTER_API_KEY)
#   ollama    -> local Ollama OpenAI-compatible shim at OLLAMA_BASE_URL
#   vllm      -> local/remote vLLM OpenAI-compatible server at LLM_VLLM_BASE_URL
LLM_PROVIDER=mock

# OpenRouter (https://openrouter.ai) — set LLM_PROVIDER=openrouter to use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (local) — set LLM_PROVIDER=ollama to use.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# vLLM (local/remote) — set LLM_PROVIDER=vllm to use.
LLM_VLLM_BASE_URL=
LLM_VLLM_MODEL=meta-llama/Llama-3-8b-instruct

# Static RAG template directory (FR-3.15.3 / C9). Defaults to the bundled
# middleware/ai/rag_templates when unset.
RAG_TEMPLATE_DIR=

# Downstream EHR/FHIR ingestion endpoint for the harness (FR-3.15.7).
# When unset, the harness runs a local round-trip signal-preservation check.
EHR_INGEST_URL=
