# Database Configuration
DB_PASSWORD=biosync_secure_password
POSTGRES_USER=biosync_user
POSTGRES_DB=biosync

# JWT Configuration (SRS NFR-S7: never hard-code secrets)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, inject via Docker secrets (JWT_SECRET_FILE) or env var.
# When ENVIRONMENT=production and JWT_SECRET is unset, the app refuses to start.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# External API Keys (Optional)
# ACCESSGUDID_API_KEY: reserved (AccessGUDID public API needs none today)
# CLINVAR_API_KEY:     NCBI E-utilities key (raises rate limit 3/s -> 10/s)
# OPENFDA_API_KEY:     openFDA key (raises UDI search quota; optional)
ACCESSGUDID_API_KEY=
CLINVAR_API_KEY=
OPENFDA_API_KEY=

# External API response cache directory
# Defaults to <tempdir>/biosync_cache when unset.
BIOSYNC_CACHE_DIR=
